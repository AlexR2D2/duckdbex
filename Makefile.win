# Windows build for the DuckDB package-build source tree.
#
# The vendored DuckDB sources are generated on demand by bin/regen_duckdb.sh,
# which produces c_src/duckdb/.sources and c_src/duckdb/.include_dirs.
# This makefile is the MSVC/NMake counterpart of Makefile.

!IF EXIST("Makefile.auto.win")
!INCLUDE Makefile.auto.win
!ENDIF

NMAKE = nmake -$(MAKEFLAGS)

!IFNDEF CXX
CXX = cl
!ENDIF

!IFNDEF ERTS_INCLUDE_PATH
ERL_CFLAGS =
!ELSE
ERL_CFLAGS = -I"$(ERTS_INCLUDE_PATH)"
!ENDIF

all: priv\duckdb_nif.dll

!IF !EXIST("c_src\duckdb\.sources")
!ERROR c_src\duckdb\.sources is missing. Run bin\regen_duckdb.sh <ref> first (see README).
!ENDIF

build.rsp: c_src\duckdb\.sources c_src\duckdb\.include_dirs bin\win_build_rsp.ps1
	powershell -NoProfile -ExecutionPolicy Bypass -File bin\win_build_rsp.ps1

Makefile.auto.win:
	erl -noshell -s init stop -eval "io:setopts(standard_io, [{encoding, unicode}]), io:format(\"ERTS_INCLUDE_PATH=~ts/erts-~ts/include/\", [code:root_dir(), erlang:system_info(version)])." > $@

!IFDEF ERTS_INCLUDE_PATH
priv\duckdb_nif.dll: build.rsp
	@if NOT EXIST "priv" mkdir "priv"
	$(CXX) @build.rsp $(ERL_CFLAGS) /LD /Fe$@ /Fo:priv/
!ELSE
priv\duckdb_nif.dll: Makefile.auto.win build.rsp
	$(NMAKE) -F Makefile.win priv\duckdb_nif.dll
!ENDIF

clean:
	@if EXIST "priv" rmdir /s /q "priv"
	@if EXIST "build.rsp" del /f /q "build.rsp"
